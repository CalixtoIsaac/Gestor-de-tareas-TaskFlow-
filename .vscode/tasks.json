{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: compilar proyecto",
            "type": "shell",
            "command": "mvn",
            "args": [
                "compile"
            ],
            "options": {
                "cwd": "${workspaceFolder}/demo"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$javac"
            ],
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}